<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Locker Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.0.6/css/pico.min.css">
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="container">
      <nav>
        <ul>
          <li><strong><%= link_to "Locker Platform", root_path %></strong></li>
          <li><%= link_to "Lockers", lockers_path %></li>
          <li><%= link_to "Action log", action_log_path %></li>
        </ul>
        <ul>
          <li>
            <%# Mock authentication: pick who you are. %>
            <%= form_with url: session_path, method: :patch, class: "user-switcher" do |f| %>
              <%= f.select :user_id,
                    options_from_collection_for_select(User.order(:role, :id), :id, :label, current_user.id) %>
              <%= f.submit "Switch" %>
            <% end %>
          </li>
        </ul>
      </nav>
    </header>

    <main class="container">
      <% if notice %><p><ins><%= notice %></ins></p><% end %>
      <% if alert %><p><mark><%= alert %></mark></p><% end %>

      <%= yield %>
    </main>
  </body>
</html>
